rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the user is a member of the group
    function isMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Users: only the user themselves can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // userGroups subcollection
      match /userGroups/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Groups
    match /groups/{groupId} {
      // Any authenticated user can read groups (needed for joinGroupByCode query)
      allow read: if request.auth != null;
      // Any authenticated user can create a group
      allow create: if request.auth != null;
      // Only group members can update/delete
      allow update, delete: if request.auth != null && isMember(groupId);

      // Members subcollection
      match /members/{memberId} {
        allow read: if request.auth != null;
        // Allow create for joining (user may not be a member yet)
        allow create: if request.auth != null;
        // Only members can update/delete
        allow update, delete: if request.auth != null && isMember(groupId);
      }

      // Roulette state
      match /roulette/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isMember(groupId);
      }

      // Sessions
      match /sessions/{sessionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isMember(groupId);
      }

      // Restaurants
      match /restaurants/{restaurantId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isMember(groupId);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
